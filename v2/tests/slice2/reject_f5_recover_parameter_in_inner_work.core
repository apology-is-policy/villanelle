// [F5]: the rule is that of each boundary for its own contingency. The work
// of the boundary around may mention the parameter, here to move the
// counter; the work of the boundary whose contingency restarts the loop may
// not.
control risky(fail_now : bool)
    ■ { fine {} }
    faults
    1  ⊤ ▷ t : ? fail_now
    2  t.true ▷ fault "risk"
    3  ⊤ ▷ ■ fine {}

control c(first : bool)
    ■ { ok {} }
    faults
    1  ⊤ ▷ lp : ↻ retry(~i : u32 := 0) {
           ⊢ i ≤ 2
           1  ⊤ ▷ t : ? i < 2
           2  t.false ▷ □ done {}
           3  ⊤ ▷ outer : boundary {
                  1  ⊤ ▷ i ← i + 1
                  2  ⊤ ▷ inner : boundary {
                         1  ⊤ ▷ j : u32 := i
                         2  ⊤ ▷ r : Δ risky(first) ▸ fine {}
                     } contingency (m : string) {
                         1  ⊤ ▷ recover ↑ retry
                     }
              } contingency (m2 : string) {
                  1  ⊤ ▷ escalate
              }
           4  ⊤ ▷ □ done {}
       } ▸ done {}
    2  ⊤ ▷ ■ ok {}

//! reject F5
