// [E-Build], [C1]: a captured outcome is not clonable.
extern resource file_handle

struct label {name : string, count : u32}

variant shape {circle {radius : u32} │ rect {w : u32, h : u32}}

extern control open_file()
    ■ { opened {f : file_handle} }
    uses file.read

extern control fetch(id : u32)
    ■ { ok {value : u32} │ failed {code : u32} }

control c()
    ■ { ok {} }
    ⊤ ▷ r := capture fetch(1)
    ⊤ ▷ s : outcome⟨fetch⟩ := clone(r)
    ⊤ ▷ ⊥

//! reject C1
