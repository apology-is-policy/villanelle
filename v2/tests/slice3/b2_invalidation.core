// [B2] An access kills every other live tag whose place overlaps the place
// it accesses, unless that tag is an ancestor of the tag the access goes
// through: a write kills them all, a read kills the exclusive ones. Killing
// a tag kills its descendants. Two places overlap when one is a prefix of
// the other, so places that are disjoint are not touched.

copy struct pair {x : u32, y : u32}

// A read kills no shared borrow: two shared borrows and the owner read
// together.
control reads_together(n : u32)
    ⊢ n < 1000
    ■ { ok {v : u32} }
    ⊤ ▷ ~x : u32 := n
    ⊤ ▷ s : &u32 := &x
    ⊤ ▷ t : &u32 := &x
    ⊤ ▷ y : u32 := x
    ⊤ ▷ ■ ok {s + t + y}

// X4: a read through the owner kills an exclusive borrow.
control read_kills_exclusive()
    ■ { ok {v : u32} }
    ⊤ ▷ ~x : u32 := 1
    ⊤ ▷ r : &~u32 := &~x
    ⊤ ▷ y : u32 := x
    ⊤ ▷ ■ ok {r + y}

// X4: a write through the owner kills a shared borrow.
control write_kills_shared()
    ■ { ok {v : u32} }
    ⊤ ▷ ~x : u32 := 1
    ⊤ ▷ s : &u32 := &x
    ⊤ ▷ x ← 2
    ⊤ ▷ ■ ok {s}

// A borrow does not kill its ancestors: a write through a reborrow leaves
// the borrow it was made through, and the owner, alive.
control ancestors_live()
    ■ { ok {v : u32} }
    ⊤ ▷ ~x : u32 := 1
    ⊤ ▷ r1 : &~u32 := &~x
    ⊤ ▷ r2 : &~u32 := &~r1
    ⊤ ▷ r2 ← 5
    ⊤ ▷ r1 ← r1 + 1
    ⊤ ▷ ■ ok {x}

// X4: a write through the parent kills the reborrow made through it.
control parent_kills_child()
    ■ { ok {v : u32} }
    ⊤ ▷ ~x : u32 := 1
    ⊤ ▷ r1 : &~u32 := &~x
    ⊤ ▷ r2 : &~u32 := &~r1
    ⊤ ▷ r1 ← 3
    ⊤ ▷ ■ ok {r2}

// X4: killing a tag kills its descendants. A write through the owner
// kills `r1`, and with it the shared borrow made through `r2`, which is
// made through `r1`.
control descendants_die()
    ■ { ok {v : u32} }
    ⊤ ▷ ~x : u32 := 1
    ⊤ ▷ r1 : &~u32 := &~x
    ⊤ ▷ r2 : &~u32 := &~r1
    ⊤ ▷ s : &u32 := &r2
    ⊤ ▷ x ← 9
    ⊤ ▷ ■ ok {s}

// Fields and elements that do not overlap are borrowed and written apart.
control disjoint_places()
    ■ { ok {p : pair, v : [u32]} }
    ⊤ ▷ ~p : pair := pair {1, 2}
    ⊤ ▷ rx : &~u32 := &~p.x
    ⊤ ▷ ry : &u32 := &p.y
    ⊤ ▷ rx ← ry + 10
    ⊤ ▷ p.y ← 7
    ⊤ ▷ ~v : [u32] := [1, 2]
    ⊤ ▷ r0 : &u32 := &v[0]
    ⊤ ▷ v[1] ← r0 + 5
    ⊤ ▷ ■ ok {p, v}

// X4: a write to the whole kills a borrow of a part.
control whole_kills_part()
    ■ { ok {v : u32} }
    ⊤ ▷ ~p : pair := pair {1, 2}
    ⊤ ▷ rx : &u32 := &p.x
    ⊤ ▷ p ← pair {3, 4}
    ⊤ ▷ ■ ok {rx}

// X4: a write to a part kills a borrow of the whole.
control part_kills_whole()
    ■ { ok {v : u32} }
    ⊤ ▷ ~p : pair := pair {1, 2}
    ⊤ ▷ rp : &pair := &p
    ⊤ ▷ p.x ← 5
    ⊤ ▷ ■ ok {rp.y}

// X4: a write to an element kills a borrow of that element.
control element_kills_element()
    ■ { ok {v : u32} }
    ⊤ ▷ ~v : [u32] := [1, 2]
    ⊤ ▷ r0 : &u32 := &v[0]
    ⊤ ▷ v[0] ← 5
    ⊤ ▷ ■ ok {r0}

// A read of a part kills an exclusive borrow of another part only where
// the places overlap: here they do not.
control read_beside_exclusive()
    ■ { ok {p : pair} }
    ⊤ ▷ ~p : pair := pair {1, 2}
    ⊤ ▷ rx : &~u32 := &~p.x
    ⊤ ▷ y : u32 := p.y
    ⊤ ▷ rx ← y
    ⊤ ▷ ■ ok {p}

// X4: a read of the whole kills an exclusive borrow of a part.
control whole_read_kills_part()
    ■ { ok {p : pair} }
    ⊤ ▷ ~p : pair := pair {1, 2}
    ⊤ ▷ rx : &~u32 := &~p.x
    ⊤ ▷ q : pair := p
    ⊤ ▷ rx ← 3
    ⊤ ▷ ■ ok {q}

//! run reads_together(4) => done ok {12}
//! run read_kills_exclusive() => stuck X4 B1
//! run write_kills_shared() => stuck X4 B1
//! run ancestors_live() => done ok {6}
//! run parent_kills_child() => stuck X4 B1
//! run descendants_die() => stuck X4 B1
//! run disjoint_places() => done ok {pair {12, 7}, [1, 6]}
//! run whole_kills_part() => stuck X4 B1
//! run part_kills_whole() => stuck X4 B1
//! run element_kills_element() => stuck X4 B1
//! run read_beside_exclusive() => done ok {pair {2, 2}}
//! run whole_read_kills_part() => stuck X4 B1
